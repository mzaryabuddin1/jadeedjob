NODE_ENV=production
PORT=3000
APP_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=jobsloot
DB_PASSWORD=replace-me
DB_DATABASE=jobsloot
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-at-least-32-random-characters
SOCIAL_CHALLENGE_SECRET=replace-with-an-independent-random-secret
LEGACY_ACCESS_TOKEN_GRACE_UNTIL=2026-12-31T23:59:59Z

REDIS_URL=redis://127.0.0.1:6379

STORAGE_PROVIDER=s3
S3_BUCKET=jobsloot-private
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
FACEBOOK_AUTH_ENABLED=true
FACEBOOK_APP_ID=replace-me
FACEBOOK_APP_SECRET=replace-me

TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=replace-me

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
