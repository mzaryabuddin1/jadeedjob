NODE_ENV=production
PORT=3000
# APP_URL=http://localhost:3000
APP_URL=https://jobsloot.com/
ALLOWED_ORIGINS=https://jobsloot.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=jobsloot
DB_PASSWORD=replace-me
DB_DATABASE=jobsloot
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-at-least-32-random-characters
SOCIAL_CHALLENGE_SECRET=replace-with-an-independent-random-secret
LEGACY_ACCESS_TOKEN_GRACE_UNTIL=2026-12-31T23:59:59Z

REDIS_URL=redis://127.0.0.1:6379

# Start with sql, use dual during migration, then mongo after verification.
CHAT_STORAGE_MODE=sql
MONGODB_URI=mongodb+srv://replace-me
MONGODB_CHAT_DATABASE=jobsloot_chat
MONGODB_CHAT_MAX_POOL_SIZE=50
MONGODB_CHAT_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CHAT_AUTO_INDEX=false
CHAT_AUTH_CACHE_TTL_SECONDS=30
CHAT_SHADOW_COMPARE_SAMPLE_RATE=0.1

STORAGE_PROVIDER=s3
S3_BUCKET=jobsloot-private
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
FACEBOOK_AUTH_ENABLED=true
FACEBOOK_APP_ID=replace-me
FACEBOOK_APP_SECRET=replace-me

TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=replace-me

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Legal enforcement remains disabled until approved documents are published.
LEGAL_REGISTRATION_ENFORCEMENT_ENABLED=false
LEGAL_REGISTRATION_ENFORCEMENT_AT=
LEGAL_COMMUNITY_ENFORCEMENT_ENABLED=false
LEGAL_COMMUNITY_ENFORCEMENT_AT=
